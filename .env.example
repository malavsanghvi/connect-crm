# Connect CRM — copy to .env.local and fill in.
# Only public (anon) values belong here: RLS in the database enforces access.
# Never put the service-role key in this app.

# Supabase project URL (local: http://localhost:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which center this console serves (app.centers.slug). Defaults to "jsh". Setting it names ONE organization on purpose: the
# sign-in page then always shows that organization. Leave it unset for the shared Weaver portal (its sign-in is neutral on an
# address that names no organization).
NEXT_PUBLIC_CENTER_SLUG=jsh

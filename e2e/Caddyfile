:8000 {
	@preflight method OPTIONS
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Headers "authorization, *"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Expose-Headers "*"
		defer
	}
	# Answer every CORS preflight here: Storage has no OPTIONS routes of its own
	# (member photo and recitation uploads from the web app need it).
	handle @preflight {
		respond 204
	}
	handle_path /auth/v1/* {
		reverse_proxy auth:9999 {
			header_down -Access-Control-Allow-Origin
		}
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000 {
			header_down -Access-Control-Allow-Origin
			# PostgREST closes idle keep-alive connections; Caddy does not retry a POST
			# on one it just lost (a random 502 with an empty body on RPCs). Local only.
			transport http {
				keepalive off
			}
		}
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000 {
			header_down -Access-Control-Allow-Origin
		}
	}
}
